{
  "name": "@forge-kivu/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "pnpm run build:server && pnpm run build:types",
    "build:server": "bun build src/index.ts --outdir dist --target bun",
    "build:types": "tsc -p tsconfig.build.json",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun run vitest run",
    "test:watch": "bun --bun run vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@forge-kivu/types": "workspace:*",
    "@hono/zod-validator": "catalog:",
    "drizzle-orm": "catalog:",
    "exceljs": "catalog:",
    "hono": "catalog:",
    "pino": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@forge-kivu/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:",
    "yaml": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
