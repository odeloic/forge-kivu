{
  "name": "@forge-kivu/web",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @forge-kivu/api-client build && nuxt build",
    "dev": "pnpm --filter @forge-kivu/api-client build && nuxt dev",
    "generate": "pnpm --filter @forge-kivu/api-client build && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "pnpm --filter @forge-kivu/api-client build && nuxt typecheck"
  },
  "dependencies": {
    "@forge-kivu/api-client": "workspace:*",
    "@forge-kivu/nuxt-base": "workspace:*",
    "@forge-kivu/types": "workspace:*",
    "@forge-kivu/ui": "workspace:*",
    "nuxt": "4.5.2",
    "vee-validate": "catalog:",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nuxt/test-utils": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
